# ============================================
# Required — app boots without these will crash
# ============================================

# JWT — generate met: openssl rand -hex 32
# Min. 32 tekens, anders gooit lib/jwt.ts een error.
JWT_SECRET=

# Supabase (anon = client-side, service-role = server-side writes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Voeg toe zodra je server-actions migreert naar lib/db-admin (zie review).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres directe verbinding (voor Prisma seed + migrations)
DATABASE_URL=
DIRECT_URL=

# App URL — gebruikt voor Mollie redirect/webhook URLs en absolute links.
# Production: https://kappersklok.nl (of welk domein dan ook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Payments (Mollie)
# ============================================
MOLLIE_API_KEY=

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=

# ============================================
# Cron — Vercel cron stuurt deze als Bearer-token.
# Generate met: openssl rand -hex 32. Min. 32 tekens.
# ============================================
CRON_SECRET=

# ============================================
# Seed only (db:seed) — NIET in productie nodig
# ============================================
ADMIN_EMAIL=admin@kappersklok.nl
# Min. 12 tekens. Generate met: openssl rand -base64 24
ADMIN_PASSWORD=
